@page "/categories"
@using CampGearApp.Models
@using CampGearApp.Services
@inject GearDataService DataService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>カテゴリ管理</PageTitle>

<h1>カテゴリマスタの登録</h1>

<div class="form-row">
    <input @bind="newCategoryName"
           @bind:event="oninput"
           @onkeyup="OnCategoryKeyUp"
           placeholder="新しいカテゴリ名（例：テント）" />
    <button class="btn btn-primary" @onclick="AddCategory">追加</button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="error-message">@errorMessage</p>
}

@{
    var orderedCategories = DataService.Categories.OrderBy(c => c.SortOrder).ToList();
}

@if (orderedCategories.Count > 0)
{
    <p class="hint">右端の「☰」を指で押さえたまま上下に動かすと、並び順を変更できます。</p>

    <ul class="sortable-list" id="category-sortable-list">
        @foreach (var cat in orderedCategories)
        {
            <li data-id="@cat.Id">
                <span class="category-name">@cat.Name</span>
                <button class="btn btn-small btn-danger" @onclick="() => RemoveCategory(cat)">削除</button>
                <span class="drag-handle" title="ドラッグして並び替え">☰</span>
            </li>
        }
    </ul>
}
else
{
    <p class="hint">まだカテゴリが登録されていません。</p>
}

@code {
    private string newCategoryName = string.Empty;
    private string errorMessage = string.Empty;

    private DotNetObjectReference<CategoryManage>? dotNetRef;
    private bool jsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (DataService.Categories.Count == 0)
        {
            return;
        }

        dotNetRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("sortableInterop.init", "category-sortable-list", dotNetRef);
        jsInitialized = true;
    }

    private void AddCategory()
    {
        if (DataService.AddCategory(newCategoryName, out errorMessage))
        {
            newCategoryName = string.Empty;
        }
    }

    private void OnCategoryKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddCategory();
        }
    }

    private void RemoveCategory(CategoryItem cat)
    {
        DataService.RemoveCategory(cat);
    }

    [JSInvokable]
    public void OnReordered(List<string> orderedIdStrings)
    {
        var orderedIds = orderedIdStrings.Select(Guid.Parse).ToList();
        DataService.ReorderCategoriesByIds(orderedIds);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (jsInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("sortableInterop.destroy", "category-sortable-list");
            }
            catch
            {
                // 画面遷移のタイミングによっては失敗することがあるが、実害はないため無視する
            }
        }

        dotNetRef?.Dispose();
    }
}