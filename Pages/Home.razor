@page "/"
@using CampGearApp.Models
@using CampGearApp.Services
@inject GearDataService DataService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>ギア一覧</PageTitle>

<h1>ギア一覧</h1>

<div class="form-row">
    <label>
        カテゴリで絞り込み：
        <select @bind="filterCategory">
            <option value="">すべて表示</option>
            @foreach (var cat in DataService.Categories.OrderBy(c => c.SortOrder))
            {
                <option value="@cat.Name">@cat.Name</option>
            }
        </select>
    </label>
</div>

@if (!string.IsNullOrEmpty(filterCategory))
{
    <p class="hint">行の右端「☰」を指で押さえたまま上下に動かすと、このカテゴリ内での並び順を変更できます。</p>
}
else
{
    <p class="hint">並び替えを行うには、カテゴリを1つ選択してください（すべて表示の間は並び替えできません）。</p>
}

@{
    var filteredList = FilteredGears.ToList();
}

@if (filteredList.Count > 0)
{
    <ul class="gear-card-list" id="gear-sortable-list">
        @{
            string? previousCategory = null;
        }
        @foreach (var gear in filteredList)
        {
            var canDrag = !string.IsNullOrEmpty(filterCategory) && !gear.IsDeleted;

            @if (string.IsNullOrEmpty(filterCategory) && gear.Category != previousCategory)
            {
                <li class="gear-category-heading">@gear.Category</li>
                previousCategory = gear.Category;
            }

            <li @key="gear.Id" data-id="@gear.Id" class="gear-card @(gear.IsDeleted ? "row-deleted" : "")">
                <div class="gear-card-photo">
                    @if (!string.IsNullOrEmpty(gear.PhotoDataUrl))
                    {
                        <img class="photo-thumb" src="@gear.PhotoDataUrl" alt="@gear.Name" />
                    }
                </div>

                <div class="gear-card-main">
                    <div class="gear-card-name">@gear.Name</div>
                </div>

                <div class="gear-card-actions">
                    <button class="btn btn-small btn-primary" @onclick="() => EditGear(gear)">編集</button>
                    @if (canDrag)
                    {
                        <span class="drag-handle" title="ドラッグして並び替え">☰</span>
                    }
                </div>
            </li>
        }
    </ul>
}
else
{
    <p class="hint">登録されているギアがありません。「ギア登録」画面から追加してください。</p>
}

@code {
    private string filterCategory = string.Empty;

    private DotNetObjectReference<Home>? dotNetRef;
    private bool jsInitialized;
    private string lastFilterCategory = string.Empty;
    private int lastGearCount = -1;

    private IEnumerable<GearItem> FilteredGears
    {
        get
        {
            var query = string.IsNullOrEmpty(filterCategory)
                ? DataService.Gears.AsEnumerable()
                : DataService.Gears.Where(g => g.Category == filterCategory);

            return query
                .OrderBy(g => GetCategorySortOrder(g.Category))
                .ThenBy(g => g.IsDeleted)
                .ThenBy(g => g.SortOrder);
        }
    }

    private int GetCategorySortOrder(string categoryName)
    {
        var cat = DataService.Categories.FirstOrDefault(c => c.Name == categoryName);
        return cat?.SortOrder ?? int.MaxValue;
    }

    private void EditGear(GearItem gear)
    {
        Navigation.NavigateTo($"gear/edit/{gear.Id}");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (string.IsNullOrEmpty(filterCategory))
        {
            if (jsInitialized)
            {
                await JS.InvokeVoidAsync("sortableInterop.destroy", "gear-sortable-list");
                jsInitialized = false;
                lastFilterCategory = string.Empty;
                lastGearCount = -1;
            }

            if (firstRender)
            {
                await TryScrollToQueryTarget();
            }
            return;
        }

        var currentCount = FilteredGears.Count();

        if (filterCategory == lastFilterCategory && currentCount == lastGearCount && jsInitialized)
        {
            return;
        }

        lastFilterCategory = filterCategory;
        lastGearCount = currentCount;

        dotNetRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("sortableInterop.init", "gear-sortable-list", dotNetRef);
        jsInitialized = true;

        await TryScrollToQueryTarget();
    }

    [JSInvokable]
    public void OnReordered(List<string> orderedIdStrings)
    {
        var orderedIds = orderedIdStrings.Select(Guid.Parse).ToList();
        DataService.ReorderGearsByIds(filterCategory, orderedIds);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (jsInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("sortableInterop.destroy", "gear-sortable-list");
            }
            catch
            {
                // 画面遷移のタイミングによっては失敗することがあるが、実害はないため無視する
            }
        }

        dotNetRef?.Dispose();
    }

    private bool hasScrolled;

    private async Task TryScrollToQueryTarget()
    {
        if (hasScrolled)
        {
            return;
        }

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query; // 例: "?scrollTo=xxxxxxxx-xxxx-..."

        if (string.IsNullOrEmpty(query) || !query.Contains("scrollTo="))
        {
            return;
        }

        var afterKey = query.Split("scrollTo=")[1];
        var scrollToValue = afterKey.Split('&')[0];

        if (!string.IsNullOrEmpty(scrollToValue))
        {
            hasScrolled = true;
            await JS.InvokeVoidAsync("sortableInterop.scrollToElement", scrollToValue);
        }
    }
}