@page "/checklists/record/{ChecklistId:guid}"
@using CampGearApp.Models
@using CampGearApp.Services
@inject GearDataService DataService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>キャンプ記録</PageTitle>

@if (notFound)
{
    <p class="error-message">チェックリストが見つかりませんでした。</p>
    <button class="btn btn-secondary" @onclick="BackToList">一覧に戻る</button>
}
else
{
    <h1>@checklist.Title</h1>
    <p class="hint">使用日：@checklist.EventDate.ToString("yyyy/MM/dd")</p>

    <div class="form-grid">
        <label>
            チェックイン
            <div style="display:flex;gap:6px;align-items:center;">
                <select style="flex:1;min-width:0;font-size:16px;"
                        value="@HourText(checklist.CheckInTime)"
                        @onchange="OnCheckInHourChanged">
                    <option value="">--</option>
                    @for (var h = 0; h < 24; h++)
                    {
                        <option value="@h">@h 時</option>
                    }
                </select>
                <select style="flex:1;min-width:0;font-size:16px;"
                        value="@MinuteText(checklist.CheckInTime)"
                        disabled="@(!checklist.CheckInTime.HasValue)"
                        @onchange="OnCheckInMinuteChanged">
                    @foreach (var m in MinuteChoices(checklist.CheckInTime))
                    {
                        <option value="@m">@m.ToString("00") 分</option>
                    }
                </select>
            </div>
        </label>

        <label>
            チェックアウト
            <div style="display:flex;gap:6px;align-items:center;">
                <select style="flex:1;min-width:0;font-size:16px;"
                        value="@HourText(checklist.CheckOutTime)"
                        @onchange="OnCheckOutHourChanged">
                    <option value="">--</option>
                    @for (var h = 0; h < 24; h++)
                    {
                        <option value="@h">@h 時</option>
                    }
                </select>
                <select style="flex:1;min-width:0;font-size:16px;"
                        value="@MinuteText(checklist.CheckOutTime)"
                        disabled="@(!checklist.CheckOutTime.HasValue)"
                        @onchange="OnCheckOutMinuteChanged">
                    @foreach (var m in MinuteChoices(checklist.CheckOutTime))
                    {
                        <option value="@m">@m.ToString("00") 分</option>
                    }
                </select>
            </div>
        </label>

        <label>
            サイト名
            <input @bind="checklist.SiteName"
                   @bind:after="DataService.SaveChecklistChange"
                   placeholder="例：A-3サイト" />
        </label>

        <label class="full-width url-field">
            キャンプ場・予約サイトのURL
            <div class="url-input-row" style="display:flex;gap:8px;align-items:center;">
                <input style="flex:1;min-width:0;"
                       value="@checklist.SiteUrl"
                       @oninput="OnSiteUrlInput"
                       @onchange="OnSiteUrlChanged"
                       inputmode="url" autocomplete="off"
                       placeholder="https://..." />
                @if (IsOpenableUrl(checklist.SiteUrl))
                {
                    <a class="btn btn-small btn-primary" style="white-space:nowrap;"
                       href="@checklist.SiteUrl.Trim()" target="_blank" rel="noopener noreferrer">
                        このURLを開く
                    </a>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(checklist.SiteUrl) && !IsOpenableUrl(checklist.SiteUrl))
            {
                <span class="hint">http:// または https:// から入力すると、開くボタンが表示されます。</span>
            }
        </label>

        <label>
            料金(円)
            <input inputmode="numeric" autocomplete="off"
                   @bind="FeeText"
                   @bind:after="DataService.SaveChecklistChange" />
        </label>

        <label class="full-width">
            備考
            <textarea rows="@GetNoteRows()"
                      @bind="checklist.Note"
                      @bind:after="DataService.SaveChecklistChange"></textarea>
        </label>
    </div>

    <div class="section-box">
        <h3>写真</h3>

        <InputFile OnChange="OnPhotosSelected" accept="image/*" multiple />

        @if (uploadTotal > 0)
        {
            <p class="hint">アップロード中です…（@uploadDone / @uploadTotal）</p>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p class="error-message">@errorMessage</p>
        }

        @if (!string.IsNullOrEmpty(DataService.LastErrorMessage))
        {
            <p class="error-message">@DataService.LastErrorMessage</p>
        }

        @if (checklist.Photos.Count == 0)
        {
            <p class="hint">まだ写真がありません。</p>
        }
        else
        {
            <div class="record-photo-grid">
                @foreach (var photo in checklist.Photos)
                {
                    <div class="record-photo-item" @key="photo.Id" @onclick="() => ShowPhoto(photo)">
                        <img src="@ThumbUrl(photo.Url)" alt="記録写真" loading="lazy"
                             onerror="if(!this.dataset.r){this.dataset.r=1;var i=this;setTimeout(function(){i.src=i.src},1500)}" />
                    </div>
                }
            </div>
        }
    </div>

    <button class="btn btn-secondary" @onclick="BackToList">戻る</button>

    @if (enlarged != null)
    {
        <div class="photo-overlay record-overlay" @onclick="ClosePhoto">
            <img src="@EnlargedUrl" alt="拡大写真" onerror="@FallbackScript(EnlargedUrl)" />
            <button class="btn btn-danger photo-overlay-delete"
                    @onclick="DeleteEnlargedPhoto"
                    @onclick:stopPropagation="true">この写真を削除</button>
        </div>
    }
}

@code {
    [Parameter]
    public Guid ChecklistId { get; set; }

    private ChecklistItem checklist = new();
    private bool notFound;

    private ChecklistPhoto? enlarged;
    private int uploadTotal;
    private int uploadDone;
    private string errorMessage = string.Empty;

    private string EnlargedUrl => enlarged?.Url ?? string.Empty;

    // 料金は文字入力欄で受け取り、全角数字を半角に直して数字だけを取り出す
    private string FeeText
    {
        get => checklist.Fee?.ToString() ?? string.Empty;
        set
        {
            var digits = new string((value ?? string.Empty)
                .Select(c => c >= '０' && c <= '９' ? (char)('0' + (c - '０')) : c)
                .Where(char.IsAsciiDigit)
                .ToArray());

            if (digits.Length == 0)
            {
                checklist.Fee = null;
            }
            else if (int.TryParse(digits, out var n))
            {
                checklist.Fee = n;
            }
        }
    }

    protected override void OnParametersSet()
    {
        var found = DataService.FindChecklistById(ChecklistId);
        if (found == null)
        {
            notFound = true;
            return;
        }

        notFound = false;
        checklist = found;
    }

    // 備考の行数に応じて、入力欄の高さを調整する（最低2行、最大10行）
    private int GetNoteRows()
    {
        if (string.IsNullOrEmpty(checklist.Note))
        {
            return 2;
        }

        return Math.Clamp(checklist.Note.Split('\n').Length, 2, 10);
    }

    // URLは、入力中は画面に反映し、入力欄から離れたときに保存する
    private void OnSiteUrlInput(ChangeEventArgs e)
    {
        checklist.SiteUrl = e.Value?.ToString() ?? string.Empty;
    }

    private void OnSiteUrlChanged(ChangeEventArgs e)
    {
        checklist.SiteUrl = (e.Value?.ToString() ?? string.Empty).Trim();
        DataService.SaveChecklistChange();
    }

    // ---- チェックイン・チェックアウト時刻（時と分の選択式） ----
    private static string HourText(TimeOnly? t) => t.HasValue ? t.Value.Hour.ToString() : string.Empty;

    private static string MinuteText(TimeOnly? t) => t.HasValue ? t.Value.Minute.ToString() : "0";

    // 分の選択肢は00と30。ただし過去に入れた別の分(例：15)が残っている場合は、消えないよう選択肢に加える
    private static List<int> MinuteChoices(TimeOnly? t)
    {
        var list = new List<int> { 0, 30 };
        if (t.HasValue && !list.Contains(t.Value.Minute))
        {
            list.Add(t.Value.Minute);
            list.Sort();
        }

        return list;
    }

    private static TimeOnly? ChangeHour(TimeOnly? current, string? value)
    {
        if (string.IsNullOrEmpty(value) || !int.TryParse(value, out var hour))
        {
            return null;
        }

        return new TimeOnly(hour, current?.Minute ?? 0);
    }

    private static TimeOnly? ChangeMinute(TimeOnly? current, string? value)
    {
        if (!current.HasValue || !int.TryParse(value, out var minute))
        {
            return current;
        }

        return new TimeOnly(current.Value.Hour, minute);
    }

    private void OnCheckInHourChanged(ChangeEventArgs e)
    {
        checklist.CheckInTime = ChangeHour(checklist.CheckInTime, e.Value?.ToString());
        DataService.SaveChecklistChange();
    }

    private void OnCheckInMinuteChanged(ChangeEventArgs e)
    {
        checklist.CheckInTime = ChangeMinute(checklist.CheckInTime, e.Value?.ToString());
        DataService.SaveChecklistChange();
    }

    private void OnCheckOutHourChanged(ChangeEventArgs e)
    {
        checklist.CheckOutTime = ChangeHour(checklist.CheckOutTime, e.Value?.ToString());
        DataService.SaveChecklistChange();
    }

    private void OnCheckOutMinuteChanged(ChangeEventArgs e)
    {
        checklist.CheckOutTime = ChangeMinute(checklist.CheckOutTime, e.Value?.ToString());
        DataService.SaveChecklistChange();
    }

    // http:// または https:// で始まるURLだけ「開く」ボタンを出す
    private static bool IsOpenableUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return false;
        }

        var t = url.Trim();
        return t.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || t.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
    }

    private static string ThumbUrl(string url)
    {
        return url.Replace("sz=w1000", "sz=w300");
    }

    private static string FallbackScript(string url)
    {
        return $"this.onerror=null;this.src='{ThumbUrl(url)}'";
    }

    private void ShowPhoto(ChecklistPhoto photo)
    {
        enlarged = photo;
    }

    private void ClosePhoto()
    {
        enlarged = null;
    }

    private async Task OnPhotosSelected(InputFileChangeEventArgs e)
    {
        errorMessage = string.Empty;

        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = e.GetMultipleFiles(20);
        }
        catch (Exception)
        {
            errorMessage = "一度に選べる写真は20枚までです。";
            return;
        }

        uploadTotal = files.Count;
        uploadDone = 0;
        StateHasChanged();

        foreach (var file in files)
        {
            try
            {
                var resized = await file.RequestImageFileAsync(file.ContentType, 1200, 1200);

                using var stream = resized.OpenReadStream(5 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);

                var url = await DataService.UploadPhotoAsync(ms.ToArray(), resized.Name, resized.ContentType);
                if (!string.IsNullOrEmpty(url))
                {
                    checklist.Photos.Add(new ChecklistPhoto { Url = url });
                    await DataService.SaveNowAsync();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"写真のアップロードに失敗しました：{ex.Message}";
            }

            uploadDone++;
            StateHasChanged();
        }

        uploadTotal = 0;
        StateHasChanged();
    }

    private async Task DeleteEnlargedPhoto()
    {
        var target = enlarged;
        if (target == null)
        {
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", "この写真を削除します。よろしいですか？（この操作は元に戻せません）");
        if (!confirmed)
        {
            return;
        }

        enlarged = null;
        checklist.Photos.Remove(target);
        await DataService.SaveNowAsync();
        _ = DataService.DeletePhotoAsync(target.Url);
    }

    private void BackToList()
    {
        Navigation.NavigateTo("checklists");
    }
}